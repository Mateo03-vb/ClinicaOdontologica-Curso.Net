@model IEnumerable<ClinicaOdontologica.HistorialMedico>

@{
    ViewData["Title"] = "Index";
}

<h1>HISTORIALES MEDICOS</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.alergias)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.enfermedadesPrevias)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.tipoSangre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idPaciente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Paciente)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.alergias)
            </td>
            <td>
                @Html.DisplayFor(model => item.enfermedadesPrevias)
            </td>
            <td>
                @Html.DisplayFor(model => item.tipoSangre)
            </td>
            <td>
                @Html.DisplayFor(model => item.idPaciente)
            </td>
            <td>
                @Html.DisplayFor(model => item.Paciente)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idHistorial">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.idHistorial">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.idHistorial">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
